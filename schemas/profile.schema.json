{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brain-hub:schema:profile",
  "title": "governance/profile.yml",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "master",
        "instance"
      ]
    },
    "allowed_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:brain-hub:schema:common#/$defs/classification"
      }
    }
  },
  "required": [
    "role",
    "allowed_classifications"
  ],
  "additionalProperties": false
}
