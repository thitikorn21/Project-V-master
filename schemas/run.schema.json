{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brain-hub:schema:run",
  "title": "Run log",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/base"
    }
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "$ref": "urn:brain-hub:schema:common#/$defs/id_ref"
    },
    "conductor_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "run"
    },
    "id": {
      "type": "string",
      "pattern": "^run-[a-z0-9][a-z0-9-]*$"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "unevaluatedProperties": false,
  "required": [
    "run_id",
    "task",
    "command_id",
    "executor",
    "exit_code",
    "attempt"
  ]
}
