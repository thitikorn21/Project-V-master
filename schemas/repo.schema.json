{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brain-hub:schema:repo",
  "title": "Work repo note",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/base"
    }
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "repo"
    },
    "id": {
      "type": "string",
      "pattern": "^repo-[a-z0-9][a-z0-9-]*$"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "unevaluatedProperties": false,
  "required": [
    "repo"
  ]
}
