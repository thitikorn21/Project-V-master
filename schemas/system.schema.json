{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brain-hub:schema:system",
  "title": "System note",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/base"
    },
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/knowledge"
    }
  ],
  "properties": {
    "system_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "system"
    },
    "id": {
      "type": "string",
      "pattern": "^sys-[a-z0-9][a-z0-9-]*$"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "unevaluatedProperties": false
}
