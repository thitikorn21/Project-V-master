{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brain-hub:schema:glossary",
  "title": "Glossary note",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/base"
    },
    {
      "$ref": "urn:brain-hub:schema:common#/$defs/knowledge"
    }
  ],
  "properties": {
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type": {
      "const": "glossary"
    },
    "id": {
      "type": "string",
      "pattern": "^gls-[a-z0-9][a-z0-9-]*$"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "unevaluatedProperties": false
}
